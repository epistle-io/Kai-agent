# ============================================
# KAI BACKEND - ENV TEMPLATE
# Copy to .env for local dev.
# For Fly.io production, set with: fly secrets set KEY=VALUE
# ============================================

# --- Market watchlist ---
PAIR_1=EURUSDm
PAIR_2=GBPUSDm
PAIR_3=BTCUSDm
DEFAULT_TIMEFRAME=M5
CANDLES_TO_ANALYZE=100
CHECK_INTERVAL_MINUTES=30
MAX_RISK_PERCENT=1.0

# --- Position sizing controls ---
# risk  = dynamic lot from MAX_RISK_PERCENT and stop loss
# fixed = always use FIXED_LOT_SIZE
LOT_SIZE_MODE=risk
FIXED_LOT_SIZE=0.02
MIN_LOT_SIZE=0.01
MAX_LOT_SIZE=10.0
LOT_SIZE_STEP=0.01

# --- Broker / AI keys (required) ---
GROQ_API_KEY=replace_with_groq_key
METAAPI_TOKEN=replace_with_metaapi_token
METAAPI_ACCOUNT_ID=replace_with_metaapi_account_id
OPENROUTER_API_KEY=replace_with_openrouter_key
OPENROUTER_REASONING_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_FAST_MODEL=google/gemma-2-9b-it:free
OPENROUTER_CHAT_FALLBACK_MODELS=google/gemma-2-9b-it:free,mistralai/mistral-7b-instruct:free,meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_REASONING_MAX_TOKENS=280
OPENROUTER_FAST_MAX_TOKENS=180

# --- Backend security (required in production) ---
KAI_API_KEY=replace_with_strong_random_string

# Comma-separated origins allowed by CORS.
# Examples:
# KAI_CORS_ORIGINS=https://kai.yourdomain.com
# KAI_CORS_ORIGINS=https://kai.yourdomain.com,exp://your-expo-dev-url
KAI_CORS_ORIGINS=https://kai.yourdomain.com

# --- Storage ---
# Optional: explicit SQLite path. Default is memory/kai_memory.db
KAI_DB_PATH=memory/kai_memory.db
# Optional: where timestamped DB backups are written by /admin/backup-db
KAI_DB_BACKUP_DIR=backups

# --- Deterministic prefilter tuning (optional) ---
MIN_ATR_PCT=0.03
MAX_ATR_PCT=1.50
MIN_TREND_STRENGTH_PCT=0.02

# --- Scalp pullback booster (XAU/BTC only, optional) ---
SCALP_PULLBACK_ENABLE=1
SCALP_PULLBACK_MIN_RULE_SCORE=45

# --- Legacy / optional ---
# Kept for backward compatibility. Push tokens are persisted in SQLite now.
EXPO_PUSH_TOKEN=
